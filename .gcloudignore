# Secrets
.env
.env.*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Tests
.pytest_cache/
tests/
pytest.ini

# Local data — exclude exports but include seed files needed in Docker image
data/exports/

# Development tooling
.claude/

# Firebase
.firebase/
firebase-public/
.firebaserc

# Git
.git/
.gitignore
.gcloudignore

# Node
node_modules/

# Next.js build cache — a local artifact (cloudbuild rebuilds the dashboard). Its volatile
# webpack cache files (*.pack.gz_) can vanish mid-archive and crash `gcloud builds submit`.
.next/
dashboard-next/.next/
# The static export (one HTML page per bill, ~500 MB) is a local artifact too: build-dashboard-next
# regenerates it with `npm run build` before deploy-firebase, so uploading the local copy only made
# the source tarball 50x bigger (505 MiB on 2026-10-23, a 22-minute build).
dashboard-next/out/

# Build artifacts
dist/
build/
*.egg-info/

# Logs
*.log

# macOS
.DS_Store

# Project docs
PROJECT_STATUS.md
*.md
